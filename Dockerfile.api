FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    GOATLAB_PRODUCT_ARTIFACT_ROOT=/tmp/goatlab-product

WORKDIR /app
COPY deploy/api/requirements.txt /tmp/api-requirements.txt
RUN pip install --no-cache-dir -r /tmp/api-requirements.txt \
    && useradd --create-home --uid 10001 goatlab

COPY src ./src
COPY pipelines/product ./pipelines/product
COPY db/migrations ./db/migrations
COPY deploy/api ./deploy/api
RUN chmod +x deploy/api/*.sh \
    && mkdir -p /tmp/goatlab-product \
    && chown -R goatlab:goatlab /app /tmp/goatlab-product

USER goatlab
EXPOSE 8000
CMD ["deploy/api/start.sh"]
